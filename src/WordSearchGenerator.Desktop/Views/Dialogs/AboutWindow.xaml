<Window x:Class="Wose.Desktop.Views.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:localization="clr-namespace:Wose.Desktop.Localization"
        Title="{localization:Loc AboutTitle}"
        Icon="/WoSe;component/WordSearchGenerator.Desktop.ico"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <icons:FluentIcon Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Icon="Info"
                        IconSize="Size24"
                        FontSize="22" />
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource PaneTitleTextStyle}"
                 Text="{localization:Loc AboutTitle}" />
    </StackPanel>

    <TextBlock Grid.Row="1"
               Margin="34,20,0,0"
               Text="{Binding VersionText}"
               TextWrapping="Wrap" />

    <Button Grid.Row="2"
            MinWidth="92"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            IsCancel="True"
            IsDefault="True"
            Content="{localization:Loc SettingsOk}" />
  </Grid>
</Window>
