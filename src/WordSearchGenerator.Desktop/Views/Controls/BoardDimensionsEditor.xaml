<UserControl x:Class="WordSearchGenerator.Desktop.Views.Controls.BoardDimensionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WordSearchGenerator.Desktop.Views.Controls"
             x:Name="Root"
             Focusable="False"
             HorizontalContentAlignment="Stretch"
             ToolTip="{Binding CellCountToolTip, ElementName=Root}"
             ToolTipService.ShowDuration="60000"
             VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <Style x:Key="DimensionTextBoxStyle" TargetType="TextBox">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Padding="1"
          CornerRadius="4"
          BorderThickness="1">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}" />
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
          </Trigger>
          <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}"
                       Value="False">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
               DataObject.Pasting="NumericTextBoxOnPasting"
               PreviewTextInput="NumericTextBoxOnPreviewTextInput"
               Style="{StaticResource DimensionTextBoxStyle}"
               Text="{Binding RowsText,
                              ElementName=Root,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Column="1"
                 Margin="4,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 IsHitTestVisible="False"
                 Opacity="0.65"
                 Text="×" />

      <TextBox Grid.Column="2"
               DataObject.Pasting="NumericTextBoxOnPasting"
               PreviewTextInput="NumericTextBoxOnPreviewTextInput"
               Style="{StaticResource DimensionTextBoxStyle}"
               Text="{Binding ColumnsText,
                              ElementName=Root,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
  </Border>
</UserControl>
