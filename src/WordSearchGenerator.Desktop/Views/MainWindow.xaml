<Window x:Class="WordSearchGenerator.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:converters="clr-namespace:WordSearchGenerator.Desktop.Converters"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:localization="clr-namespace:WordSearchGenerator.Desktop.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewControls="clr-namespace:WordSearchGenerator.Desktop.Views.Controls"
        xmlns:viewModels="clr-namespace:WordSearchGenerator.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/WordSearchGenerator.Desktop;component/WordSearchGenerator.Desktop.ico"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        PreviewKeyDown="MainWindowOnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <converters:PuzzleModeDisplayConverter x:Key="PuzzleModeDisplayConverter" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
            BorderThickness="0,0,0,1">
      <Menu Background="Transparent">
        <MenuItem Header="{localization:Loc MenuFile}">
          <MenuItem Header="{localization:Loc MenuNew}"
                    Click="NewProjectOnClick"
                    InputGestureText="Ctrl+N"
                    IsEnabled="{Binding IsEditorEnabled}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="DocumentAdd" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{localization:Loc MenuOpen}"
                    Click="OpenProjectOnClick"
                    InputGestureText="Ctrl+O"
                    IsEnabled="{Binding IsEditorEnabled}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="FolderOpen" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{localization:Loc MenuSave}"
                    Click="SaveProjectOnClick"
                    InputGestureText="Ctrl+S"
                    IsEnabled="{Binding IsEditorEnabled}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="Save" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{localization:Loc MenuSaveAs}"
                    Click="SaveProjectAsOnClick"
                    InputGestureText="Ctrl+Shift+S"
                    IsEnabled="{Binding IsEditorEnabled}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="SaveEdit" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{localization:Loc MenuImport}"
                    Click="ImportEntriesOnClick"
                    InputGestureText="Ctrl+I"
                    IsEnabled="{Binding IsEditorEnabled}"
                    ToolTip="{localization:Loc MenuImportTooltip}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="ArrowImport" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{localization:Loc MenuExportPrint}"
                    IsEnabled="{Binding CanExport}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="Print" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
            <MenuItem Header="{localization:Loc MenuPrintPreview}"
                      Click="PrintCurrentPreviewOnClick"
                      InputGestureText="Ctrl+P"
                      IsEnabled="{Binding CanExportBrowserPreview}">
              <MenuItem.Icon>
                <icons:FluentIcon Icon="Print"
                                  IconSize="Size20"
                                  FontSize="16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{localization:Loc MenuSavePdf}"
                      Click="SaveCurrentPreviewAsPdfOnClick"
                      InputGestureText="Ctrl+Shift+P"
                      IsEnabled="{Binding CanExportBrowserPreview}">
              <MenuItem.Icon>
                <icons:FluentIcon Icon="DocumentPdf"
                                  IconSize="Size20"
                                  FontSize="16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{localization:Loc MenuSaveDocx}"
                      Click="SaveCurrentPreviewAsDocxOnClick"
                      InputGestureText="Ctrl+Shift+W">
              <MenuItem.Icon>
                <icons:FluentIcon Icon="DocumentText"
                                  IconSize="Size20"
                                  FontSize="16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{localization:Loc MenuSaveHtml}"
                      Click="SaveCurrentPreviewAsHtmlOnClick"
                      InputGestureText="Ctrl+Shift+H">
              <MenuItem.Icon>
                <icons:FluentIcon Icon="Code"
                                  IconSize="Size20"
                                  FontSize="16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{localization:Loc MenuSavePng}"
                      Click="SaveCurrentBoardAsPngOnClick"
                      InputGestureText="Ctrl+Shift+G">
              <MenuItem.Icon>
                <icons:FluentIcon Icon="Image"
                                  IconSize="Size20"
                                  FontSize="16" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <Separator />
          <MenuItem Header="{localization:Loc MenuSettings}"
                    Click="SettingsOnClick"
                    InputGestureText="Ctrl+,"
                    IsEnabled="{Binding IsEditorEnabled}">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="Settings" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{localization:Loc MenuExit}"
                    Click="ExitOnClick"
                    InputGestureText="Alt+F4">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="Dismiss" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{localization:Loc MenuHelp}">
          <MenuItem Header="{localization:Loc MenuAbout}"
                    Click="AboutOnClick"
                    InputGestureText="F1">
            <MenuItem.Icon>
              <icons:FluentIcon Icon="Info" IconSize="Size20" FontSize="16" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>
      </Menu>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="EditorPaneColumn" Width="400" MinWidth="330" />
        <ColumnDefinition x:Name="MainSplitterColumn" Width="5" />
        <ColumnDefinition x:Name="PreviewPaneColumn" Width="*" MinWidth="430" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Margin="10,6,10,3"
                     Style="{StaticResource PaneTitleTextStyle}"
                     Text="{localization:Loc PuzzleEditor}" />

          <Grid Grid.Row="1"
                Margin="10,3,10,4"
                IsEnabled="{Binding IsEditorEnabled}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Margin="0,0,0,6"
                      Header="{localization:Loc Puzzle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="50" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0"
                             Grid.Column="0"
                             Style="{StaticResource FieldLabelTextStyle}"
                             Text="{localization:Loc Mode}" />
                  <ComboBox x:Name="ModeComboBox"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4,0,0"
                            ItemsSource="{Binding Modes}"
                            SelectedItem="{Binding Mode}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PuzzleModeDisplayConverter}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Grid.Row="0"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Style="{StaticResource FieldLabelTextStyle}"
                             Text="{localization:Loc Dimensions}" />

                  <viewControls:BoardDimensionsEditor
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="3"
                    Margin="0,4,0,0"
                    CellCountLabel="{localization:Loc CellCount}"
                    ColumnsText="{Binding ColumnsText,
                                          UpdateSourceTrigger=PropertyChanged,
                                          ValidatesOnNotifyDataErrors=True}"
                    RowsText="{Binding RowsText,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True}" />
                </Grid>
            </GroupBox>

            <TabControl Grid.Row="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                        BorderThickness="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
              <TabControl.Resources>
                <Style TargetType="TabItem"
                       BasedOn="{StaticResource {x:Type TabItem}}">
                  <Setter Property="BorderBrush" Value="Transparent" />
                  <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="EditorTabHeaderBorderStyle"
                       TargetType="Border">
                  <Setter Property="Padding" Value="10,5" />
                  <Setter Property="BorderBrush" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0 0 0 1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected,
                                                   RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                 Value="True">
                      <Setter Property="BorderBrush"
                              Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TabControl.Resources>

              <TabItem>
                <TabItem.Header>
                  <Border Style="{StaticResource EditorTabHeaderBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                      <icons:FluentIcon Margin="0,0,5,0"
                                        Icon="DocumentText"
                                        IconSize="Size20"
                                        FontSize="16" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{localization:Loc ContentTab}" />
                    </StackPanel>
                  </Border>
                </TabItem.Header>

                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <GroupBox Grid.Row="0"
                            Margin="0,0,0,6"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Header="{localization:Loc WordsOrQuestions}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Grid Grid.Row="0">
                        <Grid>
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNormalMode}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>

                          <TextBlock Grid.Row="0"
                                     Style="{StaticResource SupportingTextStyle}"
                                     Text="{localization:Loc WordsInstructions}"
                                     TextWrapping="Wrap" />
                          <TextBox x:Name="WordsTextBox"
                                   Grid.Row="1"
                                   MinHeight="90"
                                   Margin="0,5,0,0"
                                   AcceptsReturn="True"
                                   AcceptsTab="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   Text="{Binding WordsText,
                                                  UpdateSourceTrigger=PropertyChanged,
                                                  ValidatesOnNotifyDataErrors=True}"
                                   TextWrapping="NoWrap"
                                   ToolTip="{localization:Loc WordsTooltip}"
                                   VerticalScrollBarVisibility="Auto" />
                        </Grid>

                        <Grid>
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizMode}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>

                          <TextBlock Grid.Row="0"
                                     Style="{StaticResource SupportingTextStyle}"
                                     Text="{localization:Loc QuizInstructions}"
                                     TextWrapping="Wrap" />
                          <DataGrid Grid.Row="1"
                                    MinHeight="90"
                                    Margin="0,5,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="True"
                                    CanUserDeleteRows="True"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding QuizEntries}"
                                    SelectionMode="Single">
                            <DataGrid.Columns>
                              <DataGridTextColumn Width="2*"
                                                  Header="{localization:Loc Answer}"
                                                  Binding="{Binding Answer,
                                                                  UpdateSourceTrigger=PropertyChanged,
                                                                  ValidatesOnNotifyDataErrors=True}" />
                              <DataGridTextColumn Width="3*"
                                                  Header="{localization:Loc Question}"
                                                  Binding="{Binding Question,
                                                                  UpdateSourceTrigger=PropertyChanged,
                                                                  ValidatesOnNotifyDataErrors=True}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Grid>
                      </Grid>

                      <Button Grid.Row="1"
                              Margin="0,6,0,0"
                              Padding="8,4"
                              HorizontalAlignment="Left"
                              Command="{Binding ConvertToUppercaseCommand}">
                        <StackPanel Orientation="Horizontal">
                          <icons:FluentIcon Margin="0,0,5,0"
                                            Icon="TextCaseUppercase"
                                            IconSize="Size20"
                                            FontSize="16" />
                          <TextBlock VerticalAlignment="Center"
                                     Text="{localization:Loc ConvertToUppercase}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </GroupBox>

                  <GroupBox Grid.Row="1"
                            Margin="0"
                            Header="{localization:Loc SecretMessage}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource SupportingTextStyle}"
                                 Text="{Binding SecretMessageDescription}"
                                 TextWrapping="Wrap" />
                      <TextBox x:Name="SecretMessageTextBox"
                               Margin="0,5,0,0"
                               Text="{Binding SecretMessage,
                                              UpdateSourceTrigger=PropertyChanged,
                                              ValidatesOnNotifyDataErrors=True}"
                               ToolTip="{localization:Loc SecretMessageTooltip}" />
                      <CheckBox Margin="0,6,0,0"
                                IsChecked="{Binding RequireExactMessageFit}"
                                IsEnabled="{Binding IsNormalMode}"
                                ToolTip="{localization:Loc RequireExactMessageFitTooltip}">
                        <TextBlock Text="{localization:Loc RequireExactMessageFit}"
                                   TextWrapping="Wrap" />
                      </CheckBox>
                    </StackPanel>
                  </GroupBox>
                </Grid>
              </TabItem>

              <TabItem>
                <TabItem.Header>
                  <Border Style="{StaticResource EditorTabHeaderBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                      <icons:FluentIcon Margin="0,0,5,0"
                                        Icon="PaintBrush"
                                        IconSize="Size20"
                                        FontSize="16" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{localization:Loc AppearanceTab}" />
                    </StackPanel>
                  </Border>
                </TabItem.Header>

                <StackPanel Margin="8">
                  <GroupBox Header="{localization:Loc PuzzleStyle}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource SupportingTextStyle}"
                                 Text="{localization:Loc PuzzleStyleDescription}"
                                 TextWrapping="Wrap" />
                      <ComboBox Margin="0,5,0,0"
                                ItemsSource="{Binding BoardStyleIds}"
                                SelectedItem="{Binding SelectedStyleId}" />
                    </StackPanel>
                  </GroupBox>

                  <GroupBox Margin="0"
                            Header="{localization:Loc PreviewText}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource SupportingTextStyle}"
                                 Text="{localization:Loc PreviewTextDescription}"
                                 TextWrapping="Wrap" />

                      <TextBlock Margin="0,6,0,0"
                                 Style="{StaticResource FieldLabelTextStyle}"
                                 Text="{localization:Loc PuzzleHeadingOptional}" />
                      <TextBox Margin="0,4,0,0"
                               Text="{Binding PuzzleHeading,
                                              UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{localization:Loc OmitHeadingTooltip}" />

                      <TextBlock Margin="0,6,0,0"
                                 Style="{StaticResource FieldLabelTextStyle}"
                                 Text="{localization:Loc EntryListHeading}" />
                      <TextBox Margin="0,4,0,0"
                               Text="{Binding EntryListHeading,
                                              UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{localization:Loc OmitListHeadingTooltip}" />
                    </StackPanel>
                  </GroupBox>
                </StackPanel>
              </TabItem>

              <TabItem>
                <TabItem.Header>
                  <Border Style="{StaticResource EditorTabHeaderBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                      <icons:FluentIcon Margin="0,0,5,0"
                                        Icon="Settings"
                                        IconSize="Size20"
                                        FontSize="16" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{localization:Loc GenerationTab}" />
                    </StackPanel>
                  </Border>
                </TabItem.Header>

                <StackPanel Margin="8">
                  <GroupBox Header="{localization:Loc Generation}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0"
                                 Style="{StaticResource FieldLabelTextStyle}"
                                 Text="{localization:Loc ParallelAttempts}" />

                      <ComboBox Grid.Row="1"
                                Margin="0,4,0,0"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding ParallelismOptions}"
                                SelectedItem="{Binding SelectedParallelismOption}" />

                      <TextBlock Grid.Row="2"
                                 Margin="0,6,0,0"
                                 Style="{StaticResource FieldLabelTextStyle}"
                                 Text="{localization:Loc MaximumAttemptTime}" />

                      <TextBox Grid.Row="3"
                               Margin="0,4,0,0"
                               Text="{Binding MaximumAttemptTimeSecondsText,
                                              UpdateSourceTrigger=PropertyChanged,
                                              ValidatesOnNotifyDataErrors=True}"
                               ToolTip="{localization:Loc MaximumAttemptTimeTooltip}" />
                    </Grid>
                  </GroupBox>
                </StackPanel>
              </TabItem>
            </TabControl>
          </Grid>

          <Border Grid.Row="2"
                  MinHeight="112"
                  Padding="10,7"
                  BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Margin="0,0,0,6"
                      Padding="0,3"
                      CornerRadius="4"
                      ToolTip="{localization:Loc DifficultyTooltip}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                   Value="{x:Static viewModels:DifficultyDisplayState.SlowFewMinutes}">
                        <Setter Property="Background" Value="#189D5D00" />
                        <Setter Property="BorderBrush" Value="#9D5D00" />
                        <Setter Property="BorderThickness" Value="1" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                   Value="{x:Static viewModels:DifficultyDisplayState.SlowerManyMinutes}">
                        <Setter Property="Background" Value="#20CA5010" />
                        <Setter Property="BorderBrush" Value="#CA5010" />
                        <Setter Property="BorderThickness" Value="1" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                   Value="{x:Static viewModels:DifficultyDisplayState.CrazySlowHours}">
                        <Setter Property="Background" Value="#28C42B1C" />
                        <Setter Property="BorderBrush" Value="#C42B1C" />
                        <Setter Property="BorderThickness" Value="1" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                   Value="{x:Static viewModels:DifficultyDisplayState.LikelyImpossible}">
                        <Setter Property="Background" Value="#38C42B1C" />
                        <Setter Property="BorderBrush" Value="#C42B1C" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <icons:FluentIcon Grid.Column="0"
                                    Margin="0,1,6,0"
                                    VerticalAlignment="Top"
                                    IconSize="Size20"
                                    FontSize="20">
                    <icons:FluentIcon.Style>
                      <Style TargetType="{x:Type icons:FluentIcon}">
                        <Setter Property="Icon" Value="QuestionCircle" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.Estimating}">
                            <Setter Property="Icon" Value="ArrowSync" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.FastInSeconds}">
                            <Setter Property="Icon" Value="Flash" />
                            <Setter Property="Foreground" Value="#107C10" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.FastUnderMinute}">
                            <Setter Property="Icon" Value="Timer" />
                            <Setter Property="Foreground" Value="#038387" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.SlowFewMinutes}">
                            <Setter Property="Icon" Value="Clock" />
                            <Setter Property="Foreground" Value="#9D5D00" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.SlowerManyMinutes}">
                            <Setter Property="Icon" Value="Warning" />
                            <Setter Property="Foreground" Value="#CA5010" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.CrazySlowHours}">
                            <Setter Property="Icon" Value="Warning" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifficultyDisplayState}"
                                       Value="{x:Static viewModels:DifficultyDisplayState.LikelyImpossible}">
                            <Setter Property="Icon" Value="ErrorCircle" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </icons:FluentIcon.Style>
                  </icons:FluentIcon>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{localization:Loc DifficultyLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SupportingTextStyle}"
                               Text="{Binding DifficultyText}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <icons:FluentIcon Grid.Column="0"
                                  Margin="0,1,6,0"
                                  VerticalAlignment="Top"
                                  IconSize="Size20"
                                  FontSize="20">
                  <icons:FluentIcon.Style>
                    <Style TargetType="{x:Type icons:FluentIcon}"
                           BasedOn="{StaticResource SpinningFluentIconStyle}">
                      <Setter Property="Icon" Value="Info" />
                      <Setter Property="Foreground"
                              Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.Ready}">
                          <Setter Property="Icon" Value="CheckmarkCircle" />
                          <Setter Property="Foreground" Value="#107C10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.Generating}">
                          <Setter Property="Icon" Value="ArrowSync" />
                          <Setter Property="Foreground"
                                  Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.Completed}">
                          <Setter Property="Icon" Value="CheckmarkCircle" />
                          <Setter Property="Foreground" Value="#107C10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.MessageDidNotFit}">
                          <Setter Property="Icon" Value="Warning" />
                          <Setter Property="Foreground" Value="#9D5D00" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.Failed}">
                          <Setter Property="Icon" Value="ErrorCircle" />
                          <Setter Property="Foreground" Value="#C42B1C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorActionState}"
                                     Value="{x:Static viewModels:EditorActionState.Cancelled}">
                          <Setter Property="Icon" Value="DismissCircle" />
                          <Setter Property="Foreground"
                                  Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </icons:FluentIcon.Style>
                </icons:FluentIcon>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold"
                             Text="{Binding EditorStatusTitle}"
                             TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource SupportingTextStyle}"
                             Text="{Binding EditorStatusMessage}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2" HorizontalAlignment="Right">
                <Button MinWidth="112"
                        Command="{Binding GenerateCommand}"
                        IsDefault="True">
                  <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource AccentButtonStyle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <icons:FluentIcon Margin="0,0,5,0"
                                      Icon="Play"
                                      IconSize="Size20"
                                      FontSize="16" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding GenerateButtonText}" />
                  </StackPanel>
                </Button>

                <Button MinWidth="112"
                        Command="{Binding CancelCommand}">
                  <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource CancelButtonStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <icons:FluentIcon Margin="0,0,5,0"
                                      Style="{StaticResource SpinningFluentIconStyle}"
                                      Icon="ArrowSync"
                                      IconSize="Size20"
                                      FontSize="16" />
                    <TextBlock VerticalAlignment="Center" Text="{localization:Loc Cancel}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    ShowsPreview="True" />

      <Grid Grid.Column="2" Margin="10,6,10,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Style="{StaticResource PaneTitleTextStyle}"
                     Text="{localization:Loc BoardPreview}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPreview}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>

            <ToggleButton MinWidth="92"
                          Padding="9,4"
                          Command="{Binding ShowPuzzlePreviewCommand}"
                          IsChecked="{Binding IsPuzzlePreviewSelected, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <icons:FluentIcon Margin="0,0,5,0"
                                  Icon="Grid"
                                  IconSize="Size20"
                                  FontSize="15" />
                <TextBlock VerticalAlignment="Center" Text="{localization:Loc Puzzle}" />
              </StackPanel>
            </ToggleButton>

            <ToggleButton MinWidth="96"
                          Margin="4,0,0,0"
                          Padding="9,4"
                          Command="{Binding ShowSolutionPreviewCommand}"
                          IsChecked="{Binding IsSolutionPreviewSelected, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <icons:FluentIcon Margin="0,0,5,0"
                                  Icon="Eye"
                                  IconSize="Size20"
                                  FontSize="15" />
                <TextBlock VerticalAlignment="Center" Text="{localization:Loc Solution}" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
          <Grid>
            <cefSharp:ChromiumWebBrowser x:Name="PreviewBrowser"
                                         Address="about:blank">
              <cefSharp:ChromiumWebBrowser.Style>
                <Style TargetType="cefSharp:ChromiumWebBrowser">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPreview}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </cefSharp:ChromiumWebBrowser.Style>
            </cefSharp:ChromiumWebBrowser>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPreview}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <icons:FluentIcon HorizontalAlignment="Center"
                                Margin="0,0,0,10"
                                Opacity="0.6"
                                Icon="Grid"
                                IconSize="Size32"
                                FontSize="40" />
              <TextBlock HorizontalAlignment="Center"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Text="{Binding PreviewTitle}" />
              <TextBlock MaxWidth="380"
                         Margin="0,6,0,0"
                         HorizontalAlignment="Center"
                         Style="{StaticResource SupportingTextStyle}"
                         Text="{Binding PreviewMessage}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Padding="10,5,10,6"
            BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
            BorderThickness="0,1,0,0">
      <Border.ToolTip>
        <StackPanel MaxWidth="330">
          <TextBlock FontWeight="SemiBold" Text="{localization:Loc GenerationDetails}" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding ProgressToolTip}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border.ToolTip>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="{localization:Loc StatusLabel}" />
            <TextBlock Margin="4,0,0,0" Text="{Binding StatusText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{localization:Loc Elapsed}" />
            <TextBlock Margin="4,0,0,0" Text="{Binding ElapsedText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{localization:Loc Workers}" />
            <TextBlock Margin="4,0,0,0" Text="{Binding WorkersText}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{localization:Loc Tested}" />
            <TextBlock Margin="4,0,0,0" Text="{Binding TestedPositionsText}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{localization:Loc Backtracks}" />
            <TextBlock Margin="4,0,0,0" Text="{Binding BacktrackingsText}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ProgressBar Grid.Row="0"
                       Height="7"
                       IsIndeterminate="{Binding IsGenerating, Mode=OneWay}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar"
                     BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>

          <ProgressBar Grid.Row="1"
                       Height="7"
                       Minimum="0"
                       Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                       Value="{Binding ProgressValue, Mode=OneWay}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
