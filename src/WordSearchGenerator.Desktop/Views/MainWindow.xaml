<Window x:Class="WordSearchGenerator.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WoSeCon"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="DocumentAdd" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="FolderOpen" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="Save" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="SaveEdit" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Import words or questions...">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="ArrowImport" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Export / Print...">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="Print" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit">
                    <MenuItem.Icon>
                        <icons:FluentIcon Icon="Dismiss" IconSize="Size20" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="330" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="430" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="18,16,18,8"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="Puzzle editor" />

                    <ScrollViewer Grid.Row="1"
                                  Margin="18,8,12,8"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Header="Puzzle">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="3"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Mode" />
                                    <ComboBox x:Name="ModeComboBox"
                                              Grid.Row="1"
                                              Grid.ColumnSpan="3"
                                              Margin="0,5,0,12"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Normal" />
                                        <ComboBoxItem Content="Quiz" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Rows" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Columns" />

                                    <TextBox x:Name="RowsTextBox"
                                             Grid.Row="3"
                                             Grid.Column="0"
                                             Margin="0,5,0,0"
                                             Text="11"
                                             ToolTip="Number of rows in the generated matrix" />
                                    <TextBox x:Name="ColumnsTextBox"
                                             Grid.Row="3"
                                             Grid.Column="2"
                                             Margin="0,5,0,0"
                                             Text="11"
                                             ToolTip="Number of columns in the generated matrix" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Words or questions">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SupportingTextStyle}"
                                               Text="Enter one word per line. The editor will change to question-and-answer rows in quiz mode."
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="WordsTextBox"
                                             Height="210"
                                             Margin="0,9,0,0"
                                             AcceptsReturn="True"
                                             AcceptsTab="False"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"
                                             ToolTip="Words are case-sensitive; surrounding spaces will be trimmed" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Secret message">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SupportingTextStyle}"
                                               Text="The message fills cells not occupied by words. Remaining vacant cells become black boxes."
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="SecretMessageTextBox"
                                             Margin="0,9,0,0"
                                             ToolTip="Spaces are preserved as message characters" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Generation">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Parallel attempts" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Difficulty" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0,5,0,0"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Automatic" />
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="16" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Margin="0,10,0,0"
                                               Text="Not estimated" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="18,14"
                            BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Ready to generate" />
                                <TextBlock Style="{StaticResource SupportingTextStyle}"
                                           Text="Complete the puzzle definition first." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="82"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource CancelButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:FluentIcon Margin="0,0,7,0"
                                                      Icon="DismissCircle"
                                                      IconSize="Size20"
                                                      FontSize="16" />
                                    <TextBlock VerticalAlignment="Center" Text="Cancel" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    MinWidth="100"
                                    IsDefault="True"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:FluentIcon Margin="0,0,7,0"
                                                      Icon="Play"
                                                      IconSize="Size20"
                                                      FontSize="16" />
                                    <TextBlock VerticalAlignment="Center" Text="Generate" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Grid Grid.Column="2" Margin="18,16,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,12"
                           Style="{StaticResource PaneTitleTextStyle}"
                           Text="Board preview" />

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <icons:FluentIcon HorizontalAlignment="Center"
                                          Margin="0,0,0,14"
                                          Opacity="0.6"
                                          Icon="Grid"
                                          IconSize="Size32"
                                          FontSize="40" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="No board generated" />
                        <TextBlock MaxWidth="380"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SupportingTextStyle}"
                                   Text="The generated puzzle will be rendered here. This area will later host the CefSharp preview."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,11,18,13"
                BorderBrush="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="Status:" />
                        <TextBlock Margin="6,0,0,0" Text="Idle" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Elapsed" />
                        <TextBlock Margin="6,0,0,0" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Workers" />
                        <TextBlock Margin="6,0,0,0" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Tested" />
                        <TextBlock Margin="6,0,0,0" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Backtracks" />
                        <TextBlock Margin="6,0,0,0" Text="—" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0">
                    <ProgressBar.ToolTip>
                        <StackPanel MaxWidth="330">
                            <TextBlock FontWeight="SemiBold" Text="Generation details" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Detailed activity, worker and search statistics will appear here while a puzzle is being generated."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</Window>
